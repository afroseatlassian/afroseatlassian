<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 300" width="1000" height="300" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#070720"/>
      <stop offset="0.55" stop-color="#1c0d4d"/>
      <stop offset="1" stop-color="#4b1a8f"/>
    </linearGradient>
    <linearGradient id="floor" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1a0836"/>
      <stop offset="1" stop-color="#8a1fb0"/>
    </linearGradient>
    <radialGradient id="planetA" cx="0.35" cy="0.3" r="0.8">
      <stop offset="0" stop-color="#8ff3ff"/>
      <stop offset="0.5" stop-color="#3a8dff"/>
      <stop offset="1" stop-color="#5a2bd6"/>
    </radialGradient>
    <radialGradient id="planetB" cx="0.35" cy="0.3" r="0.8">
      <stop offset="0" stop-color="#ffb3f0"/>
      <stop offset="0.5" stop-color="#d13cff"/>
      <stop offset="1" stop-color="#4a1aa0"/>
    </radialGradient>
    <filter id="glow" x="-30%" y="-60%" width="160%" height="220%">
      <feGaussianBlur stdDeviation="5" result="b"/>
      <feMerge><feMergeNode in="b"/><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
    <filter id="soft" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="2" result="b"/>
      <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
    <clipPath id="clip"><rect width="1000" height="300"/></clipPath>
  </defs>

  <g clip-path="url(#clip)">
    <rect width="1000" height="300" fill="url(#bg)"/>

    <!-- stars -->
    <g fill="#ffffff" opacity="0.85">
      <circle cx="60" cy="40" r="1.4"/><circle cx="240" cy="25" r="1"/><circle cx="330" cy="70" r="1.6"/>
      <circle cx="420" cy="30" r="1"/><circle cx="600" cy="22" r="1.4"/><circle cx="690" cy="60" r="1"/>
      <circle cx="770" cy="28" r="1.6"/><circle cx="930" cy="150" r="1.2"/><circle cx="40" cy="140" r="1.2"/>
      <circle cx="880" cy="30" r="1"/><circle cx="530" cy="70" r="0.9"/><circle cx="300" cy="150" r="0.9"/>
    </g>

    <!-- squiggles -->
    <path d="M135 30 l14 16 l-14 16 l14 16 l-14 16" fill="none" stroke="#b06cff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" filter="url(#soft)"/>
    <path d="M885 170 l12 -14 l12 14 l12 -14 l12 14 l12 -14" fill="none" stroke="#ff5ce1" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" filter="url(#soft)"/>

    <!-- planets -->
    <circle cx="165" cy="175" r="52" fill="url(#planetA)" filter="url(#soft)"/>
    <g transform="rotate(-20 865 85)">
      <ellipse cx="865" cy="85" rx="62" ry="12" fill="none" stroke="#ff9df0" stroke-width="3" opacity="0.8"/>
      <circle cx="865" cy="85" r="36" fill="url(#planetB)" filter="url(#soft)"/>
      <path d="M803 85 a62 12 0 0 0 124 0" fill="none" stroke="#ff9df0" stroke-width="3" opacity="0.9"/>
    </g>

    <!-- grid floor -->
    <rect x="0" y="215" width="1000" height="85" fill="url(#floor)"/>
    <g stroke="#ff37d8" stroke-width="1.6" opacity="0.85" filter="url(#soft)">
      <line x1="0" y1="215" x2="1000" y2="215"/>
      <line x1="0" y1="223" x2="1000" y2="223"/>
      <line x1="0" y1="234" x2="1000" y2="234"/>
      <line x1="0" y1="249" x2="1000" y2="249"/>
      <line x1="0" y1="269" x2="1000" y2="269"/>
      <line x1="0" y1="296" x2="1000" y2="296"/>
      <line x1="500" y1="215" x2="500" y2="300"/>
      <line x1="500" y1="215" x2="400" y2="300"/><line x1="500" y1="215" x2="300" y2="300"/>
      <line x1="500" y1="215" x2="200" y2="300"/><line x1="500" y1="215" x2="100" y2="300"/>
      <line x1="500" y1="215" x2="0" y2="300"/><line x1="500" y1="215" x2="-150" y2="300"/>
      <line x1="500" y1="215" x2="600" y2="300"/><line x1="500" y1="215" x2="700" y2="300"/>
      <line x1="500" y1="215" x2="800" y2="300"/><line x1="500" y1="215" x2="900" y2="300"/>
      <line x1="500" y1="215" x2="1000" y2="300"/><line x1="500" y1="215" x2="1150" y2="300"/>
    </g>

    <!-- title -->
    <text x="500" y="112" text-anchor="middle" font-family="'Trebuchet MS', Verdana, Arial, sans-serif" font-size="70" font-weight="700" letter-spacing="6" fill="#ffffff" filter="url(#glow)">MD AFROSE</text>
    <text x="500" y="155" text-anchor="middle" font-family="'Brush Script MT', 'Segoe Script', cursive" font-style="italic" font-size="30" fill="#ff8fe0" filter="url(#soft)">Jira Administrator</text>
    <text x="500" y="196" text-anchor="middle" font-family="'Trebuchet MS', Verdana, Arial, sans-serif" font-size="15" letter-spacing="4" fill="#ffffff">JIRA CLOUD | JSM | AUTOMATION | ITSM | CLOUD MIGRATION</text>
  </g>
</svg>
